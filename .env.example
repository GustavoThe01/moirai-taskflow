# Variáveis do profile prod. Copie para .env (ignorado pelo Git) e preencha com valores de verdade.
# Nunca coloque a chave real neste arquivo de exemplo.
SPRING_PROFILES_ACTIVE=prod
MOIRAI_DB_URL=jdbc:sqlite:/dados/moirai.db?foreign_keys=on
# Gere com: openssl rand -base64 32
MOIRAI_JWT_SECRET=
MOIRAI_ADMIN_EMAILS=
